# Copy to .env and fill in your own key. Never commit .env.
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V4-Pro
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_ATTEMPTS=2
# Comma-separated model allowlist. The default and bundled DeepSeek models are included.
DATAPILOT_ALLOWED_MODELS=
# Set true in a deployed environment. Startup remains usable locally when false.
DATAPILOT_REQUIRE_API_TOKEN=false
# Protects the HTTP API when set.
DATAPILOT_API_TOKEN=
DATAPILOT_AUDIT_DB=.datapilot/audit.db
